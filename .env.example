# ── Servidor ──
# En Render NO pongas PORT: Render lo asigna solo.
PORT=4000
# En Render: production. Con production el servidor NO arranca si faltan
# JWT_SECRET (32+ caracteres), ENCRYPTION_KEY o CORS_ORIGINS.
NODE_ENV=development
# Render/Railway/Fly ponen un proxy delante: 1 = confiar en un salto
# (necesario para que los límites por IP no se compartan entre todos).
# Vacío = automático (1 en producción, desactivado en desarrollo).
TRUST_PROXY=

# ── Usuarios iniciales (solo si la base está vacía) ──
# Fuera de producción se crean las cuentas DEMO de CREDENCIALES.md.
# En producción NO (sus contraseñas son públicas): se crea UN admin con
# estos datos; después se invita al resto desde el panel.
SEED_DEMO=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Dirección Académica

# ── IA: DeepSeek primero, Gemini como última opción ──
# Las keys viven SOLO en el servidor (nunca llegan al navegador, y la
# interfaz no menciona qué proveedor se usa). Se prueba DeepSeek; si se
# queda sin saldo, se satura o falla, se usa Gemini. Con una sola key
# configurada se usa solo ese proveedor.
# DeepSeek: https://platform.deepseek.com → API keys (es prepago: carga saldo).
DEEPSEEK_API_KEY=
# Modelo (nombre oficial en api-docs.deepseek.com). Vacío = deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
# Espera máxima por respuesta de DeepSeek (ms). Escribe más lento que
# Gemini: con menos de ~60 s se cortan variantes largas y responde Gemini.
DEEPSEEK_TIMEOUT_MS=90000
# Precio por 1 millón de tokens del proveedor principal (USD), para
# mostrar costos al docente. Opcional: sin ellos solo se muestran tokens.
IA_PRECIO_ENTRADA_1M=
IA_PRECIO_SALIDA_1M=

# Gemini (respaldo)
GEMINI_API_KEY=
# 'gemini-flash-latest' es un ALIAS de Google que siempre apunta a la
# versión Flash estable más reciente — evita que con el tiempo quedes
# pinneado a un modelo que Google fue dejando de priorizar (por eso
# empieza a tirar más 503 "saturado") o que directamente dio de baja.
# Si preferís fijar una versión puntual, confirmá primero cuál sigue
# vigente en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
# Timeout por intento (ms). Si Google tarda más que esto en responder,
# se aborta y se reintenta/rota de modelo en vez de dejar la petición
# colgada 30-40s (que es lo que se vio en el log: casi 2 min antes del 503).
GEMINI_TIMEOUT_MS=20000
# Pausa entre solicitudes a Gemini (ms, al azar entre MIN y MAX). El plan
# gratuito limita las solicitudes por minuto: espaciarlas 2-4 s evita
# saturarlo sin activar facturación. Generar 10 variantes = 11 llamadas,
# o sea ~30 s más. 0 = sin pausa.
GEMINI_ESPERA_MIN_MS=2000
GEMINI_ESPERA_MAX_MS=4000
# Modelos de respaldo si GEMINI_MODEL se satura (429/503/timeout) y
# agota sus reintentos. Vacío = sin fallback. Ejemplo:
# GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest,gemini-3.8-flash
# (verificá vigencia en el link de arriba antes de listar un modelo acá —
# los modelos dados de baja, como gemini-2.0-flash y anteriores, no sirven)
GEMINI_MODEL_FALLBACK=
# Variantes por actividad: con IA hasta este número (cada una gasta
# tokens); sin IA, una por estudiante. Cuántas se piden a la vez.
VARIANTES_IA=10
VARIANTES_CONCURRENCIA=3

# ── Auth ──
# En producción: 32+ caracteres aleatorios. Generar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=8h
JWT_STUDENT_EXPIRES_IN=3h

# ── CORS ──
# En producción: la URL de Vercel, sin barra final. Varias, separadas
# por coma. Vercel crea una URL nueva en cada deploy: para aceptarlas
# todas, usa un patrón con * (cubre un tramo sin puntos), ej.:
#   CORS_ORIGINS=https://mi-app.vercel.app,https://mi-app-*-mi-equipo.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Correo transaccional (verificación de cuenta, reset de
#    contraseña, avisos de seguridad, confirmación de cambio de email) ──
# 'consola' (por defecto) = modo sandbox: el correo se imprime en la
# terminal del servidor en vez de mandarse — sirve para probar todo el
# flujo en local sin credenciales reales. Cambia a 'resend' para mandar
# correos de verdad.
EMAIL_PROVIDER=consola
# API key de https://resend.com (Dashboard → API Keys). Solo hace falta
# si EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Remitente. El DOMINIO de este correo necesita, antes de mandar en
# serio (si no, todo cae en spam o rebota):
#   1. Agregar el dominio en Resend (Dashboard → Domains → Add Domain).
#   2. Publicar en el DNS de ese dominio los registros que Resend te
#      da ahí mismo: un TXT para SPF (o agregar "include:amazonses.com"
#      a tu SPF existente), un CNAME/TXT para DKIM, y opcionalmente un
#      TXT para DMARC (ej. "v=DMARC1; p=quarantine; rua=mailto:tu@dominio").
#   3. Esperar a que Resend marque el dominio como "Verified" (puede
#      tardar unos minutos a un par de horas según tu proveedor de DNS).
EMAIL_FROM="English Lessons <no-reply@tudominio.com>"
# Base pública del FRONTEND (no del API) — para armar los enlaces que
# van DENTRO de los correos (activar cuenta, reset, confirmar email).
APP_URL=http://localhost:5173
# Vida de los tokens de un solo uso (verificación/reset/cambio de email).
AUTH_TOKEN_TTL_MIN=20

# ── Seguridad del inicio de sesión ──
# Código de 6 dígitos al correo después de la contraseña (opcional,
# desactivado). NECESITA correo real (EMAIL_PROVIDER=resend): con
# 'consola' el código solo aparece en el log del servidor.
LOGIN_CODIGO_EMAIL=false
# Captcha "No soy un robot" (Cloudflare Turnstile) en el login y al
# activar cuentas: clave SECRETA (dash.cloudflare.com → Turnstile).
# Va en pareja con VITE_TURNSTILE_SITE_KEY del frontend. Vacío = sin captcha.
# Clave de prueba de Cloudflare (siempre aprueba): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ── Base de datos (Postgres / Supabase) ──────────────────────
# Si DEJAS ESTO VACÍO, el sistema corre 100% con archivos JSON
# (modo demo, sin dependencias). Si lo llenas, persiste en Postgres.
#
# Supabase: Project Settings → Database → Connection string (URI).
# Usa el pooler (puerto 6543) para apps serverless o el directo (5432).
#   DATABASE_URL=postgresql://postgres:CONTRASEÑA@db.XXXX.supabase.co:5432/postgres
# Antes de arrancar:
#   1. Ejecuta src/db/schema.sql (SQL Editor de Supabase, o psql).
#   2. Carga libros/lecciones/vocabulario:
#        DATABASE_URL=... node scripts/cargar-contenido.mjs
DATABASE_URL=
# DB_SSL se activa solo con Supabase; ponlo en true si tu Postgres exige SSL.
DB_SSL=

# ── Privacidad: retención y cifrado de la identidad de estudiantes ──
# Días tras fin de curso o retiro antes de que el nombre del estudiante
# se anonimice solo. Parámetro (no un valor fijo en código): ajústalo
# según lo que acuerdes con cada instituto. 30–60 es razonable; 90 como
# máximo extendido.
DATA_RETENTION_DAYS=30
# Cada cuántas horas corre el job que revisa y purga lo vencido.
PURGE_INTERVAL_HOURS=6
# Llave de cifrado en reposo para la tabla `estudiantes` (AES-256-GCM).
# SIN esto, el sistema arranca igual pero usa una llave de DESARROLLO
# fija y avisa en consola — no la dejes vacía en producción. Generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Observabilidad (logging, errores, alertas) ───────────────
# Nivel de los logs estructurados: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Webhook para avisos si el servicio se cae o tira errores 5xx —
# compatible con el formato de "incoming webhook" de Slack/Discord/
# Mattermost (un POST con { text }). Vacío = las alertas solo quedan
# en el log, no se manda nada por red.
ALERT_WEBHOOK_URL=

# ── Backups y plan de recuperación ───────────────────────────
# Carpeta donde se guardan los backups con timestamp (JSON + dump de
# Postgres si hay DATABASE_URL). Por defecto: ./backups
BACKUP_DIR=
# Cada cuántas horas corre el backup automático.
BACKUP_INTERVAL_HOURS=24
# Cuántos backups recientes conservar (se podan los más viejos).
BACKUP_RETAIN_COUNT=14
